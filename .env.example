# K-Growth Insights TOSS environment
# DATABASE_PATH는 선택사항이며, 상대경로를 주면 TOSS/ 기준으로 해석된다(기본값은
# TOSS/backend/data/kgrowth_toss.db이므로 보통은 이 값을 비워둔다).
DATABASE_PATH=TOSS/backend/data/kgrowth_toss.db
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# 토스증권 Open API 자격증명
# 발급: https://openapi.tossinvest.com
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# --- 아래는 루트 backend/, frontend/(V2 소스 사본)용 선택 항목 ---
# 값을 비워두면(=.env에 안 넣으면) V2 사본은 자기 코드의 기본값을 그대로 써서
# TOSS와 충돌하지 않는다(백엔드 :8000, 프론트 :5173, DB는 backend/data/kgrowth.db).
# 네이버 검색 API(뉴스) 자격증명 — 없으면 뉴스 수집만 그레이스풀하게 비활성화된다.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
