# K-Growth Insights TOSS environment
# 아래 값을 비워두면 backend/app/config.py의 기본값을 그대로 쓴다
# (DB: backend/data/kgrowth.db, CORS: http://localhost:5173).

# 토스증권 Open API 자격증명(실시간 시세용). 여기 넣거나 앱의 설정 → API 키 화면에서 저장한다
# (화면 저장값이 우선). 둘 다 없으면 실시간 시세 없이 네이버 수집 데이터만 표시된다.
# 발급: https://openapi.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 뉴스 검색 자격증명(NAVER API HUB) — 선택. 설정 → API 키 화면에서 저장해도 된다.
# 없으면 뉴스 수집만 그레이스풀하게 비활성화된다.
# 발급: 네이버 클라우드 플랫폼 콘솔 → NAVER API HUB → Application 등록 → 인증 정보
#   (https://api.ncloud-docs.com/docs/naver-api-hub-overview). 기존 네이버 개발자센터 키는 쓸 수 없다.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 공유 API 키(선택) — 백엔드를 로컬 밖(터널/클라우드)으로 노출할 때만 설정한다.
# 설정 시 frontend/.env의 VITE_API_KEY에도 반드시 같은 값으로 맞춰야 한다.
# API_KEY=

# 아래는 필요할 때만 기본값을 덮어쓴다.
# DATABASE_PATH=backend/data/kgrowth.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
